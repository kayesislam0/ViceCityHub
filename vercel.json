{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.vicecityhub.okenshop.com"
        }
      ],
      "destination": "https://vicecityhub0.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/source",
      "destination": "https://github.com/kayesislam0/ViceCityHub",
      "permanent": false
    },
    {
      "source": "/report",
      "destination": "https://github.com/kayesislam0/ViceCityHub/issues/new?template=bug.yml",
      "permanent": false
    },
    {
      "source": "/idea",
      "destination": "https://github.com/kayesislam0/ViceCityHub/issues/new?template=idea.yml",
      "permanent": false
    },
    {
      "source": "/good-first-issues",
      "destination": "https://github.com/kayesislam0/ViceCityHub/labels/good%20first%20issue",
      "permanent": false
    },
    {
      "source": "/issues",
      "destination": "https://github.com/kayesislam0/ViceCityHub/issues",
      "permanent": false
    },
    {
      "source": "/security-report",
      "destination": "https://github.com/kayesislam0/ViceCityHub/security/advisories/new",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/hub/(fonts|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/hub/(hub\\.css|hub\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
